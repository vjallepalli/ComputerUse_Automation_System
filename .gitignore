# --- Secrets: never commit ---
.env
.env.*
!.env.example

# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
ENV/

# --- Tooling caches ---
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# --- Playwright ---
/playwright-report/
/test-results/
# Browser binaries are installed via `playwright install`, not vendored.

# --- Run output (generated; may contain redacted-but-still-sensitive context) ---
# Generated run captures are ignored. Curated, redacted deliverable bundles live
# outside these dirs (evidence/examples/, artifacts/*.json) and commit normally --
# no `git add -f` needed.
/evidence/runs/
/artifacts/runs/

# --- OS ---
.DS_Store
