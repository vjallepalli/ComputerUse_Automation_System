# Copy to .env and fill in. .env is gitignored and must never be committed.

# --- LLM provider (discovery run only; replay never reads these) ---
ANTHROPIC_API_KEY=

# Model used by the discovery agent. Default to the latest capable Claude model.
AGENT_MODEL=claude-sonnet-5

# --- Target app ---
# Port 5000 is commonly taken on macOS (Control Center / AirPlay Receiver), so
# the app defaults to 5001. Keep TARGET_APP_BASE_URL in sync with TARGET_APP_PORT.
TARGET_APP_PORT=5001
TARGET_APP_BASE_URL=http://127.0.0.1:5001

# Demo credentials for the local Flask target app. These are fake, local-only
# values, but they still live in .env and are redacted out of all evidence.
TARGET_APP_USERNAME=clerk
TARGET_APP_PASSWORD=vault

# --- Run behavior ---
# safe | confirm | blocked  -- highest risk tier the agent may auto-execute
# without human escalation. Anything above this tier goes to /escalation.
AGENT_MAX_AUTO_RISK_TIER=safe
